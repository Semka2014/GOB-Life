<Window x:Class="GOB_Life_Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GOB-Life - симуляция естественного отбора" Height="580" Width="1200" Background="#FFDFDFDF">
    <Window.Resources>
        <Style x:Key="BoxExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="#FF999999" BorderThickness="1"
                                Background="#FFbab8b8">
                            <StackPanel>
                                <ToggleButton x:Name="Tb"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}"
                                              Style="{x:Null}"
                                              Background="#FFc8c6c6"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch"
                                              Padding="0" Cursor="Hand">
                                    <DockPanel Margin="6,4,6,4">
                                        <Grid DockPanel.Dock="Left" Width="10"
                                              VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Path x:Name="ArrowRight"
                                                  Data="M 0 0 L 5 4 L 0 8 Z"
                                                  Fill="#FF555555"/>
                                            <Path x:Name="ArrowDown"
                                                  Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="#FF555555"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          TextElement.FontWeight="Medium"
                                                          TextElement.FontSize="12"
                                                          RecognizesAccessKey="True"/>
                                    </DockPanel>
                                </ToggleButton>
                                <Border x:Name="Separator" Height="1"
                                        Background="#FF999999" Visibility="Collapsed"/>
                                <ContentPresenter x:Name="ExpanderContent"
                                                  Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Separator" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ArrowRight" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ArrowDown" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Tb" Property="Background" Value="#FFc0bebe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="255"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="5" Background="#FFC5C3C3" LastChildFill="True">

            <StackPanel DockPanel.Dock="Bottom" Margin="5,5,5,5">
                <Separator Margin="0,4,0,4"/>
                <CheckBox x:Name="renderChexBox" IsChecked="true" Content="Визуализация" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="pause" Grid.Column="0" Margin="0,0,2,0" Click="Pause_Click" Content="| |"/>
                    <Button x:Name="step" Grid.Column="1" Margin="2,0,0,0" Content="▶|" Click="Step_Click"/>
                </Grid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Visible">
                <StackPanel Margin="5">

                    <Label x:Name="simInfoText" Padding="0,4,0,4">Симуляция не запущена</Label>
                    <Button Margin="0,0,0,6" Click="StartSim_Click" Content="▶ Запуск симуляции" FontWeight="SemiBold"/>

                    <Expander Header="Настройки" IsExpanded="True" Style="{StaticResource BoxExpander}">
                        <StackPanel Margin="6,5,6,6">
                            <Label Padding="0,2">Сид:</Label>
                            <TextBox x:Name="seedInput" Margin="0,0,0,4"/>

                            <Label Padding="0,2">Размер поля:</Label>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="mapWidthInput" Grid.Column="0" Margin="0,0,2,0" Text="ширина (350)"/>
                                <TextBox x:Name="mapHeightInput" Grid.Column="1" Margin="2,0,0,0" Text="высота (200)"/>
                            </Grid>

                            <Label Padding="0,2">Режим отображения:</Label>
                            <ComboBox x:Name="vizMode" Margin="0,0,0,4" SelectedIndex="0" DropDownClosed="VizMode_DropDownClosed">
                                <ComboBoxItem Content="родня"/>
                                <ComboBoxItem Content="энергия"/>
                                <ComboBoxItem Content="хищники"/>
                                <ComboBoxItem Content="возраст"/>
                                <ComboBoxItem Content="потомки"/>
                            </ComboBox>

                            <Label Padding="0,2">Действие мыши:</Label>
                            <ComboBox x:Name="mouseAction" Margin="0,0,0,4" SelectedIndex="0">
                                <ComboBoxItem Content="осмотреть бота"/>
                                <ComboBoxItem Content="убить бота"/>
                                <ComboBoxItem Content="создать еду"/>
                                <ComboBoxItem Content="очистить клетку"/>
                                <ComboBoxItem Content="вставить бота с днк"/>
                            </ComboBox>

                            <CheckBox x:Name="oxRengerBox" IsChecked="False" Click="oxRengerBox_Click">Отображать кислород</CheckBox>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Воздействия" IsExpanded="False" Style="{StaticResource BoxExpander}">
                        <UniformGrid Columns="2" Margin="4">
                            <Button Content="💀 Убить 50%" Margin="2" Click="KillHalf_Click" ToolTip="Удалить половину ботов"/>
                            <Button Content="🧬 Мутировать" Margin="2" Click="MutateAll_Click" ToolTip="Мутировать всех ботов"/>
                            <Button Content="⬆️ O2 +30%" Margin="2" Click="IncreaseO2_Click"/>
                            <Button Content="⬇️ O2 −30%" Margin="2" Click="DecreaseO2_Click"/>
                            <Button Content="⚡+ Энергия" Margin="2" Click="IncreaseEnergy_Click"/>
                            <Button Content="⚡− Энергия" Margin="2" Click="DecreaseEnergy_Click"/>
                            <Button Content="🍎 + Еда" Margin="2" Click="AddFood_Click"/>
                            <Button Content="🗑️ − Еда" Margin="2" Click="RemoveFood_Click"/>
                        </UniformGrid>
                    </Expander>

                    <Expander Header="Запись видео" IsExpanded="False" Style="{StaticResource BoxExpander}">
                        <StackPanel Margin="6,5,6,6">
                            <CheckBox x:Name="RecordingCheck" Margin="0,0,0,4">Запись видео</CheckBox>
                            <Label Padding="0,2">Частота кадров:</Label>
                            <TextBox x:Name="rocordInput" Margin="0,0,0,4" Text="3"/>
                            <Button Content="Очистить запись" Click="ClearRecord"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Автосохранение" IsExpanded="False" Style="{StaticResource BoxExpander}">
                        <StackPanel Margin="6,5,6,6">
                            <CheckBox x:Name="simsaveCheck" Margin="0,0,0,4">Автосохранение симуляции</CheckBox>
                            <Label Padding="0,2">Частота сохранения:</Label>
                            <TextBox x:Name="simsaveInput" Text="500"/>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Grid Grid.Column="1">
            <Border x:Name="MapBorder" Background="#FFC5C3C3" Margin="5,5,5,5" Cursor="Pen">
                <Image x:Name="MapBox" Stretch="Uniform" MouseLeftButtonUp="MapBox_MouseLeftButtonUp"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,5,5"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button Content="💾" Height="22" Width="22" Margin="2,0,0,0" Click="SaveSim_Click"/>
                <Button Content="📁" Height="22" Width="22" Margin="2,0,0,0" Click="LoadSim_Click"/>
                <Button Content="⚙️" Height="22" Width="22" Margin="2,0,0,0" Click="Settings_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>